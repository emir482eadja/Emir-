local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

local Window = OrionLib:MakeWindow({Name = "Beamed v2 (by Emir)", HidePremium = false, SaveConfig = true, ConfigFolder = "EmirHub"})

-- Tab: Farm++
local FarmTab = Window:MakeTab({Name = "Farm++", Icon = "rbxassetid://4483345998", PremiumOnly = false})

FarmTab:AddToggle({
    Name = "Auto Gym Bench",
    Default = false,
    Callback = function(Value)
        _G.autoBench = Value
        while _G.autoBench do
            game:GetService("ReplicatedStorage").Events.addStat:FireServer("Bench", 10)
            task.wait(0.1)
        end
    end
})

