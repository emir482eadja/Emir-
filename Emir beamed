-- Tab: Killing
local KillTab = Window:MakeTab({Name = "Killing", Icon = "rbxassetid://4483345998", PremiumOnly = false})

KillTab:AddButton({
    Name = "Auto Join Brawl",
    Callback = function()
        while true do
            game:GetService("ReplicatedStorage").Events.joinBrawl:FireServer()
            task.wait(10)
        end
    end
})

-- Tab: Stats
local StatsTab = Window:MakeTab({Name = "Stats", Icon = "rbxassetid://4483345998", PremiumOnly = false})

StatsTab:AddToggle({
    Name = "Anti AFK",
    Default = true,
    Callback = function(Value)
        if Value then
            local vu = game:GetService("VirtualUser")
            game:GetService("Players").LocalPlayer.Idled:Connect(function()
                vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
                task.wait(1)
                vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
            end)
        end
    end
})

-- Tab: Credits
local CreditsTab = Window:MakeTab({Name = "Credits", Icon = "rbxassetid://4483345998", PremiumOnly = false})

CreditsTab:AddParagraph("Script by","Emir")

